# Configuración del Entorno - Sistema de Gerencia de Proyectos Municipal (SGP)
PROJECT_NAME="Sistema de Gerencia de Proyectos Municipal (SGP)"
API_V1_STR="/api/v1"
SECRET_KEY="clave_secreta_super_segura_para_desarrollo_cambiar_en_produccion"
ALGORITHM="HS256"
