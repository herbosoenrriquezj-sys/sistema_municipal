# Base de datos:
# Por defecto usa SQLite para desarrollo local inmediato sin requerir instalaciones externas.
# Para conectar a Supabase o PostgreSQL en la nube, descomentar y ajustar:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DATABASE_URL="sqlite:///./sgp_municipal.db"

# CORS Origins permitidos (para desarrollo con React / Vite)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

